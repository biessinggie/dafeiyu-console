<Window x:Class="DafeiyuConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大肥鱼" Width="1280" Height="870" MinWidth="1120" MinHeight="740"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="#0C0618" ResizeMode="CanResize"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" CornerRadius="14" ClipToBounds="True" Background="#0C0618">
        <Grid>
            <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="1"/>

            <!-- 背景立绘（二次元软件那种：人物在右侧，向左淡出） -->
            <Grid x:Name="ArtLayer" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
                <Image x:Name="HeroArt" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Height="620" Margin="0,0,-40,-30" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0.15" EndPoint="1,0.55">
                            <GradientStop Color="#00FFFFFF" Offset="0.05"/>
                            <GradientStop Color="#B3FFFFFF" Offset="0.45"/>
                            <GradientStop Color="#FFFFFFFF" Offset="0.9"/>
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
            </Grid>

            <!-- 光斑 -->
            


            <!-- 内容 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏底部渐隐暗带 -->
                <Border Grid.Row="0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#B30C0618" Offset="0"/>
                            <GradientStop Color="#660C0618" Offset="0.7"/>
                            <GradientStop Color="#000C0618" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 标题栏 -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="18,0,0,0">
                        <StackPanel.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.9" Color="#101020"/>
                        </StackPanel.Effect>
                        <Border Width="24" Height="24" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource PinkC}" Offset="0"/>
                                    <GradientStop Color="{StaticResource MauveC}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="🐋" FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="大肥鱼" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Console" Foreground="{StaticResource OverlayBrush}"
                                   FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="TitleActivity" Text="" FontSize="11"
                               Foreground="#B9AEDC" VerticalAlignment="Center"
                               HorizontalAlignment="Center" MaxWidth="520"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" Color="#101020"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border x:Name="OnlinePill" CornerRadius="10" Background="#99201A38"
                                Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="OnlineDot" Width="7" Height="7"
                                         Fill="{StaticResource OverlayBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="OnlineText" Text="离线"
                                           Foreground="{StaticResource SubtextBrush}"
                                           FontSize="11" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="ThemeBtn" Content="☀" Width="30" Height="26"
                                Click="ThemeBtn_Click" Style="{StaticResource KeyButton}"
                                HorizontalContentAlignment="Center" FontSize="12"
                                ToolTip="切换深色 / 浅色"/>
                        <Button x:Name="MinBtn" Content="—" Width="34" Height="26"
                                Click="MinBtn_Click" Style="{StaticResource KeyButton}"
                                HorizontalContentAlignment="Center" FontSize="13"/>
                        <Button x:Name="MaxBtn" Content="□" Width="34" Height="26"
                                Click="MaxBtn_Click" Style="{StaticResource KeyButton}"
                                HorizontalContentAlignment="Center" FontSize="12"/>
                        <Button x:Name="CloseBtn" Content="✕" Width="34" Height="26"
                                Click="CloseBtn_Click" Style="{StaticResource KeyButton}"
                                HorizontalContentAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <!-- 三栏 -->
                <Grid Grid.Row="1" Margin="16,0,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftCol" Width="296"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="RightCol" Width="248"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="HeroCard" Grid.Row="0" Padding="20,22,20,18" CornerRadius="20"
                                    Background="#8C1A1430" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <Grid x:Name="AvatarBox" Width="196" Height="196" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Avatar_Click" ToolTip="点一下换个角度">
                                    <!-- 外层柔光 -->
                                    <Ellipse Width="196" Height="196">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#55CBA6F7" Offset="0.55"/>
                                                <GradientStop Color="#00CBA6F7" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- 圆形头像（社交软件那种裁法） -->
                                    <Ellipse Width="164" Height="164">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"
                                                        AlignmentX="Center" AlignmentY="Center"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- 渐变描边 -->
                                    <Ellipse Width="170" Height="170" StrokeThickness="2.5">
                                        <Ellipse.Stroke>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{StaticResource PinkC}" Offset="0"/>
                                                <GradientStop Color="{StaticResource MauveC}" Offset="0.5"/>
                                                <GradientStop Color="{StaticResource SkyC}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Stroke>
                                    </Ellipse>
                                    <!-- 内圈深色分隔，让边缘更干净 -->
                                    <Ellipse Width="166" Height="166" Stroke="#1B1030" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="StatusDot" Width="20" Height="20"
                                             Fill="{StaticResource OverlayBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0,0,14,14" Stroke="#150C2C" StrokeThickness="3.5"/>
                                </Grid>

                                <TextBlock Text="大肥鱼" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                <TextBlock x:Name="SubText" Text="本鲸今天也在营业" FontSize="11.5"
                                           Foreground="{StaticResource OverlayBrush}"
                                           HorizontalAlignment="Center" Margin="0,5,0,14"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border CornerRadius="10" Background="#26F5C2E7"
                                            BorderBrush="#55F5C2E7" BorderThickness="1"
                                            Padding="11,4">
                                        <TextBlock x:Name="ModeChip" Text="都回" FontSize="11"
                                                   Foreground="{StaticResource PinkBrush}"/>
                                    </Border>
                                    <Border CornerRadius="10" Background="#12FFFFFF"
                                            BorderThickness="1" BorderBrush="#1EFFFFFF"
                                            Padding="11,4" Margin="8,0,0,0">
                                        <TextBlock x:Name="TurnsChip" Text="今日 0 轮" FontSize="11"
                                                   Foreground="{StaticResource SubtextBrush}"/>
                                    </Border>
                                </StackPanel>

                                <Grid Margin="0,18,0,0">
                                    <TextBlock Text="心情" FontSize="11"
                                               Foreground="{StaticResource OverlayBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Height="8" CornerRadius="4" Background="#14FFFFFF"
                                            Margin="42,0,30,0" VerticalAlignment="Center">
                                        <Border x:Name="MoodFill" CornerRadius="4"
                                                HorizontalAlignment="Left" Width="60">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="{StaticResource SkyC}" Offset="0"/>
                                                    <GradientStop Color="{StaticResource PinkC}" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock x:Name="MoodFace" Text="😐" FontSize="13"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock x:Name="Credit" Text="形象 · 大肥鱼设定 CC BY-NC-SA 4.0" FontSize="9"
                                           Foreground="#8A7FB0" HorizontalAlignment="Center"
                                           Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        

                        <Border x:Name="MiniCard" Grid.Row="1" Style="{StaticResource Glass}" Padding="16,14"
                                Margin="0,12,0,0" VerticalAlignment="Top">
                            <StackPanel>
                                <Grid Margin="0,0,0,9">
                                    <TextBlock Text="今日互动" FontSize="12"
                                               Foreground="{StaticResource SubtextBrush}"/>
                                    <TextBlock x:Name="MTurns" Text="0" FontSize="13"
                                               FontWeight="SemiBold" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,9">
                                    <TextBlock Text="累计消息" FontSize="12"
                                               Foreground="{StaticResource SubtextBrush}"/>
                                    <TextBlock x:Name="MMsgs" Text="0" FontSize="13"
                                               FontWeight="SemiBold" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextBrush}"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="收藏帖子" FontSize="12"
                                               Foreground="{StaticResource SubtextBrush}"/>
                                    <TextBlock x:Name="MSaved" Text="0" FontSize="13"
                                               FontWeight="SemiBold" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 中 -->
                    <Grid Grid.Column="1" Margin="14,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 她的话 -->
                        <Border Grid.Row="0" Style="{StaticResource Glass}" Padding="22,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🐋" FontSize="13"/>
                                        <TextBlock Text="她刚才说" FontSize="11.5" Margin="7,0,0,0"
                                                   Foreground="#CFBFEF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DoingText" Text="" FontSize="11"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource OverlayBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="WordsText" Text="（她还没说话）" FontSize="15"
                                           LineHeight="27" TextWrapping="Wrap"
                                           Foreground="#FBF7FF"/>
                            </StackPanel>
                        </Border>

                        <!-- 三个数字 -->
                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,12,0,0">
                            <Border Style="{StaticResource Glass}" Padding="16,12" Margin="0,0,6,0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="🌸 今日花费" FontSize="11"
                                                   Foreground="{StaticResource OverlayBrush}"/>
                                        <TextBlock x:Name="SToday" Text="¥0.000" FontSize="19"
                                                   FontWeight="SemiBold" Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                    <Polyline x:Name="SparkLine" Stroke="{StaticResource MauveBrush}"
                                              StrokeThickness="1.5" VerticalAlignment="Bottom"
                                              HorizontalAlignment="Right" Opacity="0.9"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Glass}" Padding="16,12" Margin="6,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="💬 累计花费" FontSize="11"
                                               Foreground="{StaticResource OverlayBrush}"/>
                                    <TextBlock x:Name="STotal" Text="¥0.00" FontSize="19"
                                               FontWeight="SemiBold" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Glass}" Padding="16,12" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="⭐ 对话轮数" FontSize="11"
                                               Foreground="{StaticResource OverlayBrush}"/>
                                    <TextBlock x:Name="STurns" Text="0" FontSize="19"
                                               FontWeight="SemiBold" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- 日志面板 -->
                        <Border Grid.Row="2" Style="{StaticResource Glass}" Margin="0,12,0,0"
                                Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="14,10,10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TabLog" Content="日志"
                                                Style="{StaticResource TabButton}"
                                                Click="TabLog_Click" Foreground="{StaticResource PinkBrush}"/>
                                        <Button x:Name="TabChat" Content="对话"
                                                Style="{StaticResource TabButton}"
                                                Click="TabChat_Click"/>
                                        <Button x:Name="TabChart" Content="用量"
                                                Style="{StaticResource TabButton}"
                                                Click="TabChart_Click"/>
                                    </StackPanel>
                                    <StackPanel x:Name="FilterBar" Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button x:Name="FAll" Content="全部"
                                                Style="{StaticResource TabButton}"
                                                FontSize="11" Padding="8,4"
                                                Click="Filter_Click" Tag="all"
                                                Foreground="{StaticResource TextBrush}"/>
                                        <Button x:Name="FGroup" Content="群聊"
                                                Style="{StaticResource TabButton}"
                                                FontSize="11" Padding="8,4"
                                                Click="Filter_Click" Tag="group"/>
                                        <Button x:Name="FPriv" Content="私聊"
                                                Style="{StaticResource TabButton}"
                                                FontSize="11" Padding="8,4"
                                                Click="Filter_Click" Tag="priv"/>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12" LineHeight="19" Padding="16,4,16,14"
                                               Foreground="#D6C9F2" TextWrapping="Wrap"/>
                                </ScrollViewer>

                                <Canvas x:Name="ChartCanvas" Grid.Row="1" Margin="16,28,16,12"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- 输入 -->
                        <Border Grid.Row="3" Style="{StaticResource Glass}" Margin="0,12,0,0"
                                Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="›" FontSize="18"
                                           Foreground="{StaticResource PinkBrush}"
                                           VerticalAlignment="Center" Margin="2,0,8,0"/>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="SayBox" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextBrush}" FontSize="13.5"
                                             VerticalContentAlignment="Center" CaretBrush="{StaticResource PinkBrush}"
                                             KeyDown="SayBox_KeyDown"/>
                                    <TextBlock x:Name="SayHint" Text="跟她说一句…" FontSize="13.5"
                                               Foreground="{StaticResource OverlayBrush}"
                                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="Enter" FontSize="10"
                                           Foreground="#8A7FB0" VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <Button Grid.Column="3" x:Name="SendBtn" Content="发送"
                                        Style="{StaticResource PrimaryButton}" Click="Send_Click"
                                        Padding="18,7"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 右：功能键 -->
                    <Border Grid.Column="2" Padding="12,14" CornerRadius="20"
                            Background="#991A1430" BorderBrush="#2AFFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="6,0,6,8">
                                <TextBlock Text="功能" FontSize="11"
                                           Foreground="{StaticResource OverlayBrush}"/>
                                <Button x:Name="ExpandAllBtn" Content="全部展开" FontSize="10"
                                        HorizontalAlignment="Right" Padding="4,0"
                                        Style="{StaticResource TabButton}"
                                        Click="ExpandAll_Click"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="KeyList"/>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" x:Name="StatusList" Margin="6,10,6,0"/>

                            <Button Grid.Row="3" x:Name="QuitBtn" Content="退出控制台"
                                    Style="{StaticResource GhostButton}" Margin="4,12,4,0"
                                    Click="Quit_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
